{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-4.6",
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "permission": {
    "edit": "ask",
    "write": "ask",
    "bash": {
      "*": "deny",
      "git log*": "allow",
      "git diff*": "allow",
      "git status": "allow",
      "git show*": "allow",
      "git branch*": "allow"
    },
    "pipeline": "deny"
  }
}
